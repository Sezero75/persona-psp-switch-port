+static inline sr_cd_status sr_cd_rename_file_ex(const sr_cd_root *r,const char *src_rel,
+                                                const char *dst_rel,int replace) {
+    if(!src_rel || !*src_rel || !dst_rel || !*dst_rel) return SR_CD_INVALID_PATH;
+    char src[SR_FAT_PATH_CAP],dst[SR_FAT_PATH_CAP],prev[SR_FAT_PATH_CAP];
+    sr_cd_status st=sr_fat_path(r,src_rel,NULL,src);
+    if(st!=SR_CD_OK || (st=sr_fat_path(r,dst_rel,NULL,dst))!=SR_CD_OK ||
+       (st=sr_fat_recover(src))!=SR_CD_OK || (st=sr_fat_kind(src,0))!=SR_CD_OK ||
+       (st=sr_fat_recover(dst))!=SR_CD_OK) return st;
+    if(strlen(src)==strlen(dst) && !sr_vfs_strnicmp(src,dst,strlen(src)))
+        return replace ? SR_CD_OK : SR_CD_ALREADY_EXISTS;
+    st=sr_fat_kind(dst,0);
+    if(st==SR_CD_NOT_FOUND) return rename(src,dst)==0 ? SR_CD_OK : sr_fat_errno();
+    if(st!=SR_CD_OK || !replace) return st==SR_CD_OK ? SR_CD_ALREADY_EXISTS : st;
+    if(!sr_fat_previous_path(dst,prev)) return SR_CD_INVALID_PATH;
+    if(rename(dst,prev)) return sr_fat_errno();
+    if(rename(src,dst)) {
+        sr_cd_status failure=sr_fat_errno();
+        if(rename(prev,dst)) return SR_CD_IO_ERROR;
+        return failure;
+    }
+    return unlink(prev)==0 ? SR_CD_OK : sr_fat_errno();
+}
+static inline sr_cd_status sr_cd_rename_file(const sr_cd_root *r,const char *src,const char *dst) {
+    return sr_cd_rename_file_ex(r,src,dst,1);
+}
+static inline sr_cd_status sr_cd_set_mode(const sr_cd_root *r,const char *rel,uint32_t mode) {
+    (void)mode;
+    char path[SR_FAT_PATH_CAP];
+    sr_cd_status st=sr_fat_path(r,rel,NULL,path);
+    return st==SR_CD_OK ? SR_CD_UNSUPPORTED_HOST : st; /* FAT has no Unix permission bits. */
+}
+static inline sr_cd_status sr_cd_sync_dir(const sr_cd_root *r,const char *rel) {
+    sr_cd_status st=sr_cd_dir_is_contained(r,rel);
+    if(st!=SR_CD_OK) return st;
+#if defined(SR_CD_FAT_TEST)
+    return SR_CD_OK;
+#else
+    return nx_sdmc_commit() ? SR_CD_OK : SR_CD_IO_ERROR;
+#endif
+}
+static inline sr_cd_status sr_cd_lock_dir(const sr_cd_root *r,const char *rel,int *fd_out) {
+    if (!fd_out) return SR_CD_INVALID_PATH;
+    *fd_out=-1;
+    char path[SR_FAT_PATH_CAP];
+    sr_cd_status st=sr_fat_path(r,rel,".nakagawa-savedata-lock",path);
+    if(st!=SR_CD_OK) return st;
+    /* Horizon keeps open write handles exclusive. Keep the lock file permanently;
+     * release is closing the handle, including process exit after a crash. */
+    int fd=open(path,O_RDWR|O_CREAT|O_BINARY,0666);
+    if(fd<0) return sr_fat_errno();
+    *fd_out=fd;
+    return SR_CD_OK;
+}
+static inline void sr_cd_unlock_dir(int fd) { if(fd>=0) close(fd); }
