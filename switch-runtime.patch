+// SPDX-License-Identifier: GPL-3.0-or-later
+/* libnx sdmc: exposes only FAT regular files and directories. A validated
+ * component cannot redirect to another filesystem. This backend must never
+ * be selected for a desktop filesystem or a different Horizon device. */
+#ifndef SR_VFS_SWITCH_FAT_H
+#define SR_VFS_SWITCH_FAT_H
+
+#define SR_FAT_PATH_CAP 1024
+#define SR_FAT_PREVIOUS ".~sr-old"
+#if defined(SR_CD_FAT_TEST)
+#define SR_FAT_PREFIX "fat-test-volume/"
+#if defined(_WIN32)
+#include <direct.h>
+#include <io.h>
+#define sr_fat_mkdir(p) _mkdir(p)
+#endif
+#else
+int nx_sdmc_commit(void);
+#define SR_FAT_PREFIX "sdmc:/"
+#endif
+#ifndef sr_fat_mkdir
+#define sr_fat_mkdir(p) mkdir((p),0777)
+#endif
+#ifndef O_BINARY
+#define O_BINARY 0
+#endif
+
+static inline int sr_cd_component_is_host_ok(const char *c,size_t n) {
+    size_t suffix=sizeof(SR_FAT_PREVIOUS)-1;
+    return sr_vfs_is_safe_component(c,n) &&
+           !(n>=suffix && !sr_vfs_strnicmp(c+n-suffix,SR_FAT_PREVIOUS,suffix));
+}
+static inline sr_cd_status sr_fat_errno(void) {
+    switch(errno) {
+        case ENOENT: return SR_CD_NOT_FOUND;
+        case ENOTDIR: return SR_CD_NOT_A_DIRECTORY;
+        case EISDIR: return SR_CD_IS_DIRECTORY;
+        case EEXIST: return SR_CD_ALREADY_EXISTS;
+        case ENOTEMPTY: return SR_CD_NOT_EMPTY;
+        case EINVAL: case ENAMETOOLONG: return SR_CD_INVALID_PATH;
+        default: return SR_CD_IO_ERROR;
+    }
+}
+static inline sr_cd_status sr_cd_root_open(const char *name,sr_cd_root *root) {
+    if (!root) return SR_CD_INVALID_PATH;
+    root->prefix[0]=0;
+    size_t base=sizeof(SR_FAT_PREFIX)-1;
+    if (!name || strncmp(name,SR_FAT_PREFIX,base) || strlen(name)>=sizeof(root->prefix) ||
+        !sr_cd_rel_is_acceptable(name+base)) return SR_CD_INVALID_PATH;
+    struct stat info;
+    if (stat(name,&info)) return sr_fat_errno();
+    if (!S_ISDIR(info.st_mode)) return SR_CD_NOT_A_DIRECTORY;
+    memcpy(root->prefix,name,strlen(name)+1);
+    return SR_CD_OK;
+}
+static inline void sr_cd_root_close(sr_cd_root *root) { if (root) root->prefix[0]=0; }
+
+static inline sr_cd_status sr_fat_path(const sr_cd_root *r,const char *rel,
+                                       const char *leaf,char out[SR_FAT_PATH_CAP]) {
+    if (!r || !r->prefix[0] || !rel || (*rel && !sr_cd_rel_is_acceptable(rel)) ||
+        (leaf && !sr_cd_name_is_acceptable(leaf,strlen(leaf)))) return SR_CD_INVALID_PATH;
+    int n=snprintf(out,SR_FAT_PATH_CAP,"%s%s%s%s%s", r->prefix,*rel?"/":"",rel,
+                   leaf?"/":"",leaf?leaf:"");
+    return n>=0 && n<SR_FAT_PATH_CAP ? SR_CD_OK : SR_CD_INVALID_PATH;
+}
+static inline sr_cd_status sr_fat_kind(const char *path,int directory) {
+    struct stat info;
+    if (stat(path,&info)) return sr_fat_errno();
+    if (directory) return S_ISDIR(info.st_mode) ? SR_CD_OK : SR_CD_NOT_A_DIRECTORY;
+    return S_ISREG(info.st_mode) ? SR_CD_OK : SR_CD_IS_DIRECTORY;
+}
+static inline sr_cd_status sr_cd_dir_is_contained(const sr_cd_root *r,const char *rel) {
+    char path[SR_FAT_PATH_CAP];
+    sr_cd_status st=sr_fat_path(r,rel,NULL,path);
+    return st==SR_CD_OK ? sr_fat_kind(path,1) : st;
+}
+static inline sr_cd_status sr_cd_mkdir_leaf(const sr_cd_root *r,const char *rel) {
+    char path[SR_FAT_PATH_CAP];
+    if (!rel || !*rel) return SR_CD_INVALID_PATH;
+    sr_cd_status st=sr_fat_path(r,rel,NULL,path);
+    if (st!=SR_CD_OK) return st;
+    return sr_fat_mkdir(path)==0 ? SR_CD_OK : sr_fat_errno();
+}
+static inline sr_cd_status sr_cd_mkdirs(const sr_cd_root *r,const char *rel) {
+    char path[SR_FAT_PATH_CAP];
+    if (!rel || !*rel) return SR_CD_INVALID_PATH;
+    sr_cd_status st=sr_fat_path(r,rel,NULL,path);
+    if (st!=SR_CD_OK) return st;
+    char *part=path+strlen(r->prefix)+1;
+    for (;;) {
+        char *slash=strchr(part,'/');
+        if (slash) *slash=0;
+        if (sr_fat_mkdir(path) && (errno!=EEXIST || (st=sr_fat_kind(path,1))!=SR_CD_OK))
+            return st!=SR_CD_OK ? st : sr_fat_errno();
+        if (!slash) return SR_CD_OK;
+        *slash='/'; part=slash+1;
+    }
+}
+
+static inline int sr_fat_previous_path(const char *dst,char prev[SR_FAT_PATH_CAP]) {
+    const char *name=strrchr(dst,'/');
+    if (!name || strlen(name+1)+sizeof(SR_FAT_PREVIOUS)>SR_CD_NAME_MAX) return 0;
+    int n=snprintf(prev,SR_FAT_PATH_CAP,"%s%s",dst,SR_FAT_PREVIOUS);
+    return n>=0 && n<SR_FAT_PATH_CAP;
+}
+/* A power cut between the two name changes leaves either an existing
+ * destination plus its previous version, or a previous version alone. */
+static inline sr_cd_status sr_fat_recover(const char *dst) {
+    char prev[SR_FAT_PATH_CAP];
+    if (!sr_fat_previous_path(dst,prev)) return SR_CD_OK;
+    sr_cd_status old=sr_fat_kind(prev,0);
+    if (old==SR_CD_NOT_FOUND) return SR_CD_OK;
+    if (old!=SR_CD_OK) return old;
+    sr_cd_status current=sr_fat_kind(dst,0);
+    if (current==SR_CD_OK) return unlink(prev)==0 ? SR_CD_OK : sr_fat_errno();
+    if (current!=SR_CD_NOT_FOUND) return current;
+    return rename(prev,dst)==0 ? SR_CD_OK : sr_fat_errno();
+}
+static inline sr_cd_status sr_cd_open_file(const sr_cd_root *r,const char *dir,
+                              const char *leaf,sr_cd_file_mode mode,FILE **out) {
+    if (!out) return SR_CD_INVALID_PATH;
+    *out=NULL;
+    if (!leaf) return SR_CD_INVALID_PATH;
+    char path[SR_FAT_PATH_CAP];
+    sr_cd_status st=sr_fat_path(r,dir,leaf,path);
+    if (st!=SR_CD_OK || (st=sr_fat_recover(path))!=SR_CD_OK) return st;
+    static const int flags[]={
+        O_RDONLY, O_WRONLY|O_CREAT|O_TRUNC, O_RDWR, O_RDWR|O_CREAT|O_TRUNC,
+        O_RDWR|O_CREAT|O_APPEND,O_RDWR|O_TRUNC,O_RDWR|O_APPEND,
+        O_RDWR|O_CREAT|O_EXCL,O_RDWR|O_CREAT|O_EXCL|O_APPEND
+    };
+    static const char *const modes[]={"rb","wb","r+b","w+b","a+b","w+b","a+b","w+b","a+b"};
+    if ((unsigned)mode>=sizeof(flags)/sizeof(flags[0])) return SR_CD_INVALID_PATH;
+    st=sr_fat_kind(path,0);
+    if (st!=SR_CD_OK && st!=SR_CD_NOT_FOUND) return st;
+    int fd=open(path,flags[mode]|O_BINARY,0666);
+    if(fd<0) return sr_fat_errno();
+    *out=fdopen(fd,modes[mode]);
+    if(!*out) { close(fd); return SR_CD_IO_ERROR; }
+    return SR_CD_OK;
+}
+static inline sr_cd_status sr_cd_delete_file(const sr_cd_root *r,const char *rel) {
+    char path[SR_FAT_PATH_CAP];
+    if (!rel || !*rel) return SR_CD_INVALID_PATH;
+    sr_cd_status st=sr_fat_path(r,rel,NULL,path);
+    if (st!=SR_CD_OK || (st=sr_fat_recover(path))!=SR_CD_OK ||
+        (st=sr_fat_kind(path,0))!=SR_CD_OK) return st;
+    return unlink(path)==0 ? SR_CD_OK : sr_fat_errno();
+}
+static inline sr_cd_status sr_cd_delete_leaf(const sr_cd_root *r,const char *dir,const char *name) {
+    if (!name || !dir || !sr_cd_name_is_acceptable(name,strlen(name))) return SR_CD_INVALID_PATH;
+    char rel[SR_CD_REL_MAX]; int n=snprintf(rel,sizeof(rel),"%s%s%s",dir,*dir?"/":"",name);
+    return n>=0 && (size_t)n<sizeof(rel) ? sr_cd_delete_file(r,rel) : SR_CD_INVALID_PATH;
+}
+static inline sr_cd_status sr_cd_remove_dir_empty(const sr_cd_root *r,const char *rel) {
+    char path[SR_FAT_PATH_CAP];
+    if (!rel || !*rel) return SR_CD_INVALID_PATH;
+    sr_cd_status st=sr_fat_path(r,rel,NULL,path);
+    if (st!=SR_CD_OK || (st=sr_fat_kind(path,1))!=SR_CD_OK) return st;
+    return rmdir(path)==0 ? SR_CD_OK : sr_fat_errno();
+}
+static inline sr_cd_status sr_cd_delete_dir_shallow(const sr_cd_root *r,const char *rel) {
+    char path[SR_FAT_PATH_CAP];
+    if (!rel || !*rel) return SR_CD_INVALID_PATH;
+    sr_cd_status st=sr_fat_path(r,rel,NULL,path);
+    if (st!=SR_CD_OK) return st;
+    for (;;) {
+        char leaf[SR_CD_NAME_MAX]="";
+        DIR *dir=opendir(path);
+        if (!dir) return sr_fat_errno();
+        for (;;) {
+            errno=0; struct dirent *e=readdir(dir);
+            if (!e) { if(errno) st=sr_fat_errno(); break; }
+            if (!strcmp(e->d_name,".") || !strcmp(e->d_name,"..")) continue;
+            if (!sr_cd_name_is_acceptable(e->d_name,strlen(e->d_name))) continue;
+            char child[SR_FAT_PATH_CAP];
+            st=sr_fat_path(r,rel,e->d_name,child);
+            if(st!=SR_CD_OK) break;
+            st=sr_fat_kind(child,0);
+            if(st==SR_CD_IS_DIRECTORY) { st=SR_CD_OK; continue; }
+            if(st==SR_CD_OK) memcpy(leaf,e->d_name,strlen(e->d_name)+1);
+            break;
+        }
+        if(closedir(dir) && st==SR_CD_OK) st=SR_CD_IO_ERROR;
+        if(st!=SR_CD_OK) return st;
+        if(!*leaf) return sr_cd_remove_dir_empty(r,rel);
+        st=sr_cd_delete_leaf(r,rel,leaf);
